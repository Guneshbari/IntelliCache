# IntelliCache Load Testing Environment Configuration Example
# Copy this file to .env.load-test and adjust values for your environment.
# DO NOT commit real secrets or production API keys to git.

# Target Gateway Base URL
# - Host-network / Local gateway: http://127.0.0.1:8000
# - Docker-compose bridge network: http://gateway:8000
BASE_URL=http://127.0.0.1:8000

# Client Authentication Token
# Maps to a configured cache namespace in CLIENT_API_TOKENS (e.g. "default" or "load_test_ns")
CLIENT_TOKEN=test-client-token

# Admin Authentication Token (for scraping /admin/metrics)
ADMIN_TOKEN=test-admin-token

# Load Test Execution Controls
VUS=10
DURATION=30s
RAMP_UP_DURATION=5s
TARGET_RPS=50

# Shadow Sampling & Telemetry Settings
SHADOW_SAMPLING_RATE=0.10
TEST_ENVIRONMENT_LABEL=local_isolated_development
