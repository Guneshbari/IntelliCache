# ==============================================================================
# Stage 3.8A — Controlled Live Upstream Provider Evaluation Profile (Opt-In Only)
# ==============================================================================
# Copy this file to an untracked env file or export variables explicitly before
# running `scripts/evaluate_stage3_8a_live_provider.py`. NEVER commit real API
# keys or `.env` files. Normal gateway defaults MUST keep semantic serving off.

# Required explicit live evaluation opt-in & provider settings
LIVE_PROVIDER_EVALUATION_ENABLED=false
LIVE_PROVIDER_NAME=groq
# Explicitly configure the Groq model id (e.g. qwen/qwen3.8-27b)
LIVE_PROVIDER_MODEL=
GROQ_API_KEY=replace_with_your_key

# Request timeout, retry, and spend/request budget controls
LIVE_PROVIDER_TIMEOUT_SECONDS=30.0
LIVE_PROVIDER_MAX_RETRIES=1
LIVE_PROVIDER_MAX_REQUESTS=40
# Optional USD spend cap and explicit token pricing inputs (leave blank to report cost as unavailable)
# LIVE_PROVIDER_MAX_COST=0.25
# LIVE_PROVIDER_INPUT_COST_PER_MILLION=
# LIVE_PROVIDER_OUTPUT_COST_PER_MILLION=
# LIVE_PROVIDER_PRICING_SOURCE=
LIVE_PROVIDER_REPORT_DIR=/tmp/stage3_8a_eval

# Required PostgreSQL + pgvector (384-d FastEmbed) and HMAC secrets for isolated Mode C runs
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/intellicache_fastembed_test
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DIMENSIONS=384
# SEMANTIC_CACHE_EVIDENCE_SECRET=<generate-via: openssl rand -hex 32>
# PRINCIPAL_IDENTITY_SECRET=<generate-via: openssl rand -hex 32>
# ADMIN_API_TOKEN=<generate-via: openssl rand -hex 24>
# CLIENT_API_TOKENS={"tok_alice":{"namespace":"s38a_alpha","visibility":"private","allow_shared_reads":false}}
