# LLM Provider Configuration
LLM_PROVIDER=groq

# Groq API Configuration (Required for Groq provider)
GROQ_API_KEY=replace_with_your_key
GROQ_MODEL=qwen/qwen3.8-27b

# Server Configuration (Optional)
HOST=127.0.0.1
PORT=8000
DEBUG=false
CORS_ORIGINS=*
ADMIN_API_TOKEN=replace_with_admin_secret_token
CLIENT_API_TOKEN=replace_with_client_secret_token

# Caching Configuration
# Storage backend: "memory" (default for local test/dev) or "postgres" (for centralized shared cache)
CACHE_BACKEND=memory
DATABASE_URL=postgresql://user:password@localhost:5432/intellicache
CACHE_NAMESPACE=default
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000

# Inference Defaults (Optional)
DEFAULT_TEMPERATURE=0.7

# Input Payload Size Bounds (Optional - Character bounds, distinct from model token limits)
MAX_PROMPT_CHARS=131072
MAX_SYSTEM_PROMPT_CHARS=65536
MAX_MESSAGES_COUNT=100
MAX_MESSAGE_CHARS=131072

# Embedding Configuration (Optional - prepares for future semantic retrieval)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_TIMEOUT_SECONDS=30.0

# Semantic Cache & Vector Storage Configuration (Optional)
# Mode 1: Local In-Memory Mode (Zero external services required):
#   CACHE_BACKEND=memory
#   VECTOR_STORE_BACKEND=memory
#   SEMANTIC_CACHE_ENABLED=true
#   EMBEDDING_PROVIDER=fastembed
#   EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#   VECTOR_DIMENSIONS=384
#   VECTOR_STORE_MAX_ENTRIES=1000
#   (Requires: pip install -r requirements-fastembed.txt)
#
# Mode 2: Persistent PostgreSQL Mode (Shared multi-instance deployment):
#   CACHE_BACKEND=postgres
#   VECTOR_STORE_BACKEND=postgres
#   SEMANTIC_CACHE_ENABLED=true
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   VECTOR_DIMENSIONS=768
#   (Requires: PostgreSQL 16+ with pgvector, and Ollama service)

SEMANTIC_CACHE_ENABLED=false
VECTOR_STORE_BACKEND=memory
VECTOR_STORE_MAX_ENTRIES=1000
VECTOR_DIMENSIONS=384
SEMANTIC_CACHE_MIN_SIMILARITY=0.92
SEMANTIC_CACHE_MIN_MARGIN=0.03
SEMANTIC_CACHE_TOP_K=5

# Persistent Conversation Management & Bounded Context Window (Optional - requires CACHE_BACKEND=postgres)
CONVERSATION_IDENTITY_SECRET=replace_with_a_secure_random_hex_or_passphrase_at_least_16_chars
CONVERSATION_MAX_CONTEXT_MESSAGES=50
CONVERSATION_MAX_CONTEXT_CHARS=65536
