# LLM Provider Configuration
LLM_PROVIDER=groq

# Groq API Configuration (Required for Groq provider)
GROQ_API_KEY=replace_with_your_key
GROQ_MODEL=qwen/qwen3.8-27b

# Server Configuration (Optional)
HOST=127.0.0.1
PORT=8000
DEBUG=false
CORS_ORIGINS=*
ADMIN_API_TOKEN=replace_with_admin_secret_token

# Caching Configuration (Optional)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000

# Inference Defaults (Optional)
DEFAULT_TEMPERATURE=0.7

# Input Payload Size Bounds (Optional - Character bounds, distinct from model token limits)
MAX_PROMPT_CHARS=131072
MAX_SYSTEM_PROMPT_CHARS=65536
MAX_MESSAGES_COUNT=100
MAX_MESSAGE_CHARS=131072
